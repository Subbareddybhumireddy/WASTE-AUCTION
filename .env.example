# Waste to Worth - Environment Variables

# Database Connection (SQLite default for local development, or PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/waste_to_worth?schema=public"

# Authentication & Session Security
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-change-this-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Google OAuth Credentials (Optional for local testing, required for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Phone OTP Service (Twilio or Mock Dev Mode)
# When OTP_DEV_MODE=true, OTP code is logged to the server console and returned in API response for easy local testing
OTP_DEV_MODE=true
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# AI listing analysis and WasteBot (server-side only; never expose in NEXT_PUBLIC_ vars)
ANTHROPIC_API_KEY="your-claude-api-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Optional Cloudinary unsigned upload configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Stripe Connect payment authorization and seller payouts (test mode)
STRIPE_SECRET_KEY="sk_test_your-secret"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Vercel scheduled auction finalizer
CRON_SECRET="use-a-random-secret-at-least-32-characters"
